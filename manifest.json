{
    "manifest_version": 3, 
    "name": "Pretty Screentime",
    "description": "Pretty helps you understand how you spend time online—across all websites, every single day; clean, simple, and private.",
    "version": "1.2.0",    
    "content_scripts": [{
        "matches": [
    "*://*.youtube.com/*",
    "*://*.netflix.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.twitter.com/*",
    "*://*.medium.com/*",
    "*://*.linkedin.com/*",
    "*://*.slack.com/*",
    "*://*.spotify.com/*",
    "*://*.reddit.com/*",
    "*://*.twitch.com/*",
    "*://*.tumblr.com/*",
    "*://*.discord.com/*",
    "*://*.amazon.com/*",
    "*://*.stackoverflow.com/*",
    "*://*.leetcode.com/*",
    "*://*.pinterest.com/*",
    "*://*.quora.com/*"
],
        "js": ["server.js"]
    }],

    "background": {
        "service_worker": "worker.js"
    }, 

    "icons": {
        "16": "plogo16.png",
        "32": "plogo32.png",
        "48": "plogo48.png",
        "128": "plogo128.png"
    },

    "permissions": [
      "storage",
      "tabs",
      "scripting",
      "activeTab",
      "webNavigation",
      "alarms"

    ],

    "action": {
        "default_icon": {
            "16": "plogo16.png",
            "32": "plogo32.png",
            "48": "plogo48.png",
            "128": "plogo128.png"
          },
        "default_popup": "index.html"
    }

  }